# ===================================================================
# 仓库根级 .gitignore —— 整个仓库只需要这一份
#
# 作用：告诉 git "这些文件是我本机跑出来的、或者是我个人的，
#       不要纳入版本管理"。
#
# 【重要】每条规则必须独占一行。
#   .gitignore 里 `#` 只有在【行首】才是注释，
#   写在规则后面会被当成规则内容，导致这条规则静默失效
#   （我就踩过：__pycache__/   # 注释   这样写是完全无效的）。
#
# `/` 结尾表示目录；`*` 是通配符；`!` 开头表示"反向排除"。
# ===================================================================

# ---------- Python 运行产物 ----------
# 编译缓存，每次运行 Python 都会自动重新生成，不需要版本管理
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ---------- 虚拟环境 ----------
# 环境是"每台机器各自搭"的，体积大，
# 而且可以用 environment.yml 一键还原（conda env create -f environment.yml），
# 所以不入库
.venv/
venv/
env/
.conda/

# ---------- 密钥 / 本机私有配置 ----------
# .env 是【文件】不是目录：上面的 .venv/ venv/ env/ 全是目录规则，
# 一条都匹配不到它，所以必须单独写，否则 .env 会被正常纳入版本管理。
.env
.env.*
!.env.example

# ---------- 测试与代码检查工具的缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- 编辑器 / IDE 配置 ----------
# .vscode 里存的是"我这台机器用哪个解释器"这类个人设置，
# 换台机器就失效（解释器路径、环境管理器这类设置都是本机专属的）。
# 想共享的环境信息，请写进 README 或 environment.yml。
.vscode/
.idea/
*.swp

# ---------- 音频数据 ----------
# wav / mp3 体积大，而且都能用脚本重新生成（dsp-toolbox/examples/make_wave.py），
# 所以默认不入库。
# 如果某个小文件确实需要提交，用：git add -f 文件名
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aiff
*.aif

# ---------- 数据集 / 训练产物（monorepo 后期项目）----------
# 体积大、可重新下载或训练，绝不入库；趁项目还没开工就先写死。
data/
datasets/
checkpoints/
runs/
*.pth
*.pt
*.onnx
*.ncnn
*.tflite

# ---------- 数组 / 日志 / 临时文件 ----------
# DSP 实验里用 np.save / np.savez 落盘的数组：体积大，且随时能重算
*.npy
*.npz

# 运行日志与临时文件
*.log
*.tmp
*.bak

# 合并冲突残留
*.orig
*.rej

# Office 打开文档时的锁文件 / LibreOffice 的锁文件
~$*
.~lock.*

# VS Code 本地历史（Local History 扩展）
.history/

# ---------- 操作系统生成的垃圾文件 ----------
.DS_Store
Thumbs.db
desktop.ini
